# Google Sheets API Configuration
# Instructions: Copy this file to .env.local and fill in your actual values

# Google Sheets API Key (from Google Cloud Console)
# Get your API key: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# Google Sheet ID (from the spreadsheet URL)
# URL format: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit
VITE_GOOGLE_SHEET_ID=your_google_sheet_id_here
